{% doc %}
  @prompt
    new arrivals
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-new-arrivals-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 32px 0;
    color: #121212;
    font-family: var(--font-body-family, Georgia, serif);
  }

  .ai-new-arrivals__heading-{{ ai_gen_id }} {
    margin: 0 0 24px;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 400;
    line-height: 1.15;
  }

  .ai-new-arrivals__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 28px 16px;
  }

  .ai-new-arrivals__card-{{ ai_gen_id }} {
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .ai-new-arrivals__media-{{ ai_gen_id }} {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f3f3f3;
    margin-bottom: 12px;
  }

  .ai-new-arrivals__media-{{ ai_gen_id }} img,
  .ai-new-arrivals__media-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-new-arrivals__name-{{ ai_gen_id }} {
    display: block;
    margin: 0 0 5px;
    font-size: 16px;
    line-height: 1.35;
  }

  .ai-new-arrivals__price-{{ ai_gen_id }} {
    display: block;
    font-size: 14px;
    line-height: 1.4;
  }

  .ai-new-arrivals__empty-{{ ai_gen_id }} {
    padding: 24px;
    background: #f3f3f3;
    color: #444;
    font-size: 15px;
    line-height: 1.5;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-new-arrivals-{{ ai_gen_id }} {
      width: 100%;
      padding: 24px 0;
    }

    .ai-new-arrivals__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 12px;
    }
  }
{% endstyle %}

<div class="ai-new-arrivals-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-new-arrivals__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  {% if block.settings.products != blank %}
    <div class="ai-new-arrivals__grid-{{ ai_gen_id }}">
      {% for product in block.settings.products limit: block.settings.products_to_show %}
        <a class="ai-new-arrivals__card-{{ ai_gen_id }}" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
          <span class="ai-new-arrivals__media-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
            {% else %}
              <div class="ai-new-arrivals__placeholder-{{ ai_gen_id }}">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
          </span>
          <span class="ai-new-arrivals__name-{{ ai_gen_id }}">{{ product.title | escape }}</span>
          <span class="ai-new-arrivals__price-{{ ai_gen_id }}">{{ product.price | money }}</span>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-new-arrivals__empty-{{ ai_gen_id }}">Choose products in the block settings to feature your latest arrivals.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "New arrivals",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 8
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "New arrivals"
    }
  ],
  "tag": null,
  "class": "new-arrivals-block"
}
{% endschema %}