{% doc %}
  @prompt
    favourite products
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-favourites-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #121212;
  }

  .ai-favourites-{{ ai_gen_id }}__heading {
    margin: 0 0 1.5rem;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.15;
  }

  .ai-favourites-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 24px 16px;
  }

  .ai-favourites-{{ ai_gen_id }}__card {
    min-width: 0;
    color: inherit;
    text-decoration: none;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-favourites-{{ ai_gen_id }}__image-wrap {
    display: block;
    overflow: hidden;
    background: #f3f3f3;
    margin-bottom: 12px;
  }

  .ai-favourites-{{ ai_gen_id }}__image-wrap img,
  .ai-favourites-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .ai-favourites-{{ ai_gen_id }}__name {
    margin: 0 0 5px;
    font-size: 1rem;
    line-height: 1.35;
  }

  .ai-favourites-{{ ai_gen_id }}__price {
    margin: 0;
    font-size: 0.95rem;
  }

  .ai-favourites-{{ ai_gen_id }}__empty {
    padding: 22px;
    background: #f3f3f3;
    color: #333333;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-favourites-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-favourites-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 20px 12px;
    }
  }
{% endstyle %}

<div class="ai-favourites-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-favourites-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  {% if block.settings.products != blank %}
    <div class="ai-favourites-{{ ai_gen_id }}__grid">
      {% for product in block.settings.products %}
        <a class="ai-favourites-{{ ai_gen_id }}__card" href="{{ product.url }}">
          <span class="ai-favourites-{{ ai_gen_id }}__image-wrap">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', alt: product.featured_image.alt | escape }}
            {% else %}
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </span>
          <span class="ai-favourites-{{ ai_gen_id }}__name">{{ product.title | escape }}</span>
          {% if block.settings.show_price %}
            <span class="ai-favourites-{{ ai_gen_id }}__price">{{ product.price | money }}</span>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-favourites-{{ ai_gen_id }}__empty">Choose products in the block settings to feature your favourites.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Favourite products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our favourites"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 8
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Favourite products"
    }
  ],
  "tag": null,
  "class": "favourite-products-block"
}
{% endschema %}