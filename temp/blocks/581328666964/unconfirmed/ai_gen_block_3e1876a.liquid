{% doc %}
  @prompt
    best selling products
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bestsellers-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    color: rgb(var(--color-foreground));
  }

  .ai-bestsellers-{{ ai_gen_id }}__heading {
    margin: 0 0 2rem;
    text-align: {{ block.settings.heading_alignment }};
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-weight: {{ settings.type_header_font.weight }};
  }

  .ai-bestsellers-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 2.4rem 1.6rem;
  }

  .ai-bestsellers-{{ ai_gen_id }}__card {
    min-width: 0;
    text-align: left;
  }

  .ai-bestsellers-{{ ai_gen_id }}__image-link {
    display: block;
    overflow: hidden;
    background: #f3f3f3;
    color: inherit;
  }

  .ai-bestsellers-{{ ai_gen_id }}__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .ai-bestsellers-{{ ai_gen_id }}__details {
    padding-top: 1rem;
  }

  .ai-bestsellers-{{ ai_gen_id }}__title {
    margin: 0 0 0.4rem;
    font-size: 1.6rem;
    line-height: 1.3;
  }

  .ai-bestsellers-{{ ai_gen_id }}__title a {
    color: inherit;
    text-decoration: none;
  }

  .ai-bestsellers-{{ ai_gen_id }}__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .ai-bestsellers-{{ ai_gen_id }}__price {
    margin: 0;
    font-size: 1.4rem;
  }

  .ai-bestsellers-{{ ai_gen_id }}__empty {
    grid-column: 1 / -1;
    padding: 2rem;
    text-align: center;
    background: #f3f3f3;
  }

  .ai-bestsellers-{{ ai_gen_id }}__empty p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-bestsellers-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 1.8rem 1rem;
    }

    .ai-bestsellers-{{ ai_gen_id }}__heading {
      margin-bottom: 1.6rem;
    }
  }
{% endstyle %}

<div class="ai-bestsellers-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-bestsellers-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  <div class="ai-bestsellers-{{ ai_gen_id }}__grid">
    {% assign featured_products = block.settings.products %}
    {% if featured_products != blank %}
      {% for product in featured_products limit: block.settings.product_limit %}
        <article class="ai-bestsellers-{{ ai_gen_id }}__card">
          <a class="ai-bestsellers-{{ ai_gen_id }}__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            {% if product.featured_image %}
              <img
                class="ai-bestsellers-{{ ai_gen_id }}__image"
                src="{{ product.featured_image | image_url: width: 700 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >
            {% else %}
              <div class="ai-bestsellers-{{ ai_gen_id }}__image">
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </a>
          <div class="ai-bestsellers-{{ ai_gen_id }}__details">
            <h3 class="ai-bestsellers-{{ ai_gen_id }}__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            <p class="ai-bestsellers-{{ ai_gen_id }}__price">
              {% if product.price_varies %}From {% endif %}{{ product.price | money }}
            </p>
          </div>
        </article>
      {% endfor %}
    {% else %}
      <div class="ai-bestsellers-{{ ai_gen_id }}__empty">
        <p>Select the products you want to feature in this best sellers grid.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Best selling products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best sellers"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products to feature",
      "limit": 12
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Best selling products"
    }
  ],
  "tag": null,
  "class": "best-selling-products-block"
}
{% endschema %}