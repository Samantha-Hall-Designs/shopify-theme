{% doc %}
  @prompt
    customers favourite products
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-favourites-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    color: #121212;
  }

  .ai-favourites-{{ ai_gen_id }}__heading {
    margin: 0 0 2rem;
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    text-align: {{ block.settings.alignment }};
  }

  .ai-favourites-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 2rem 1rem;
  }

  .ai-favourites-{{ ai_gen_id }}__card {
    min-width: 0;
    text-align: left;
  }

  .ai-favourites-{{ ai_gen_id }}__image-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ai-favourites-{{ ai_gen_id }}__image-wrap {
    display: block;
    overflow: hidden;
    background: #f3f3f3;
    aspect-ratio: 1 / 1;
  }

  .ai-favourites-{{ ai_gen_id }}__image-wrap img,
  .ai-favourites-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-favourites-{{ ai_gen_id }}__details {
    padding-top: 0.9rem;
  }

  .ai-favourites-{{ ai_gen_id }}__title {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .ai-favourites-{{ ai_gen_id }}__title a {
    color: inherit;
    text-decoration: none;
  }

  .ai-favourites-{{ ai_gen_id }}__title a:hover,
  .ai-favourites-{{ ai_gen_id }}__title a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .ai-favourites-{{ ai_gen_id }}__price {
    margin: 0;
    font-size: 0.95rem;
  }

  .ai-favourites-{{ ai_gen_id }}__empty {
    grid-column: 1 / -1;
    padding: 2rem;
    background: #f3f3f3;
    color: #414141;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-favourites-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 0.75rem;
    }
  }
{% endstyle %}

<div class="ai-favourites-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-favourites-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  <div class="ai-favourites-{{ ai_gen_id }}__grid">
    {% if block.settings.products != blank %}
      {% for product in block.settings.products %}
        <article class="ai-favourites-{{ ai_gen_id }}__card">
          <a class="ai-favourites-{{ ai_gen_id }}__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            <span class="ai-favourites-{{ ai_gen_id }}__image-wrap">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', alt: product.featured_image.alt | default: product.title | escape }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </span>
          </a>
          <div class="ai-favourites-{{ ai_gen_id }}__details">
            <h3 class="ai-favourites-{{ ai_gen_id }}__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            <p class="ai-favourites-{{ ai_gen_id }}__price">{{ product.price | money }}</p>
          </div>
        </article>
      {% endfor %}
    {% else %}
      <div class="ai-favourites-{{ ai_gen_id }}__empty">
        <p>Select products in this block to show your customers' favourites.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Customers’ favourites",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customers’ favourites"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Featured products",
      "limit": 8
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Customers’ favourites"
    }
  ],
  "tag": null,
  "class": "customers-favourites-block"
}
{% endschema %}