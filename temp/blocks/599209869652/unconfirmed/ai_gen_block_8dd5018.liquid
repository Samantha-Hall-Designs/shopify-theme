{% doc %}
  @prompt
    add a small countdown
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 10px 14px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: center;
    font-family: inherit;
    line-height: 1.35;
  }

  .ai-countdown-{{ ai_gen_id }}__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ai-countdown-{{ ai_gen_id }}__message {
    font-size: 14px;
    font-weight: 600;
    margin: 0;
  }

  .ai-countdown-{{ ai_gen_id }}__time {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .ai-countdown-{{ ai_gen_id }}__unit {
    white-space: nowrap;
  }

  .ai-countdown-{{ ai_gen_id }}__expired {
    margin: 0;
    font-size: 13px;
  }

  @media screen and (max-width: 749px) {
    .ai-countdown-{{ ai_gen_id }} {
      width: 100%;
      padding: 9px 12px;
    }
  }
{% endstyle %}

<small-countdown-{{ ai_gen_id }}
  class="ai-countdown-{{ ai_gen_id }}"
  data-target="{{ block.settings.end_datetime | escape }}"
  data-expired-message="{{ block.settings.expired_message | escape }}"
  role="timer"
  aria-live="off"
  {{ block.shopify_attributes }}
>
  <div class="ai-countdown-{{ ai_gen_id }}__inner">
    <p class="ai-countdown-{{ ai_gen_id }}__message">{{ block.settings.message | escape }}</p>
    <span class="ai-countdown-{{ ai_gen_id }}__time" aria-label="Time remaining">
      <span class="ai-countdown-{{ ai_gen_id }}__unit"><span data-days>00</span>d</span>
      <span class="ai-countdown-{{ ai_gen_id }}__unit"><span data-hours>00</span>h</span>
      <span class="ai-countdown-{{ ai_gen_id }}__unit"><span data-minutes>00</span>m</span>
      <span class="ai-countdown-{{ ai_gen_id }}__unit"><span data-seconds>00</span>s</span>
    </span>
  </div>
</small-countdown-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'small-countdown-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;

    class SmallCountdown extends HTMLElement {
      connectedCallback() {
        this.time = this.querySelector('.ai-countdown-{{ ai_gen_id }}__time');
        this.interval = null;
        this.updateCountdown();
        this.interval = window.setInterval(() => this.updateCountdown(), 1000);
      }

      disconnectedCallback() {
        if (this.interval) window.clearInterval(this.interval);
      }

      updateCountdown() {
        const target = new Date(this.dataset.target).getTime();
        if (!Number.isFinite(target) || target <= Date.now()) {
          this.showExpired();
          return;
        }

        const remaining = target - Date.now();
        const days = Math.floor(remaining / 86400000);
        const hours = Math.floor((remaining % 86400000) / 3600000);
        const minutes = Math.floor((remaining % 3600000) / 60000);
        const seconds = Math.floor((remaining % 60000) / 1000);

        this.querySelector('[data-days]').textContent = String(days).padStart(2, '0');
        this.querySelector('[data-hours]').textContent = String(hours).padStart(2, '0');
        this.querySelector('[data-minutes]').textContent = String(minutes).padStart(2, '0');
        this.querySelector('[data-seconds]').textContent = String(seconds).padStart(2, '0');
      }

      showExpired() {
        if (this.interval) window.clearInterval(this.interval);
        const inner = this.querySelector('.ai-countdown-{{ ai_gen_id }}__inner');
        if (inner) inner.innerHTML = '<p class="ai-countdown-{{ ai_gen_id }}__expired"></p>';
        const message = this.querySelector('.ai-countdown-{{ ai_gen_id }}__expired');
        if (message) message.textContent = this.dataset.expiredMessage;
      }
    }

    customElements.define(tagName, SmallCountdown);
  })();
</script>

{% schema %}
{
  "name": "Small countdown",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "A little offer ends in"
    },
    {
      "type": "text",
      "id": "end_datetime",
      "label": "End date and time",
      "default": "2026-12-31T23:59",
      "info": "Use YYYY-MM-DDTHH:MM in your store's local time."
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "After countdown",
      "default": "This offer has ended."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F3F3F3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    }
  ],
  "presets": [
    {
      "name": "Small countdown"
    }
  ],
  "tag": null,
  "class": "small-countdown-block"
}
{% endschema %}