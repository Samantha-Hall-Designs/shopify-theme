{% doc %}
  @prompt
    countdown, make this block smaller, centre the block 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-countdown-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: {{ block.settings.vertical_padding }}px 12px;
    text-align: center;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }
  .ai-countdown-{{ ai_gen_id }}__title { margin: 0 0 4px; font-size: 18px; }
  .ai-countdown-{{ ai_gen_id }}__timer { display: flex; justify-content: center; gap: 12px; font-variant-numeric: tabular-nums; }
  .ai-countdown-{{ ai_gen_id }}__unit { min-width: 42px; }
  .ai-countdown-{{ ai_gen_id }}__number { display: block; font-size: 22px; line-height: 1.1; }
  .ai-countdown-{{ ai_gen_id }}__label { display: block; font-size: 11px; }
{% endstyle %}
<countdown-timer-{{ ai_gen_id }} class="ai-countdown-{{ ai_gen_id }}" data-end="{{ block.settings.end_datetime | escape }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-countdown-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}
  <div class="ai-countdown-{{ ai_gen_id }}__timer" aria-live="off">
    <span class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__number" data-days>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">Days</span></span>
    <span class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__number" data-hours>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">Hours</span></span>
    <span class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__number" data-minutes>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">Minutes</span></span>
    <span class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__number" data-seconds>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">Seconds</span></span>
  </div>
</countdown-timer-{{ ai_gen_id }}>
<script>
  (() => {
    const tag = 'countdown-timer-{{ ai_gen_id }}';
    if (customElements.get(tag)) return;
    class CountdownTimer extends HTMLElement {
      connectedCallback() {
        this.endTime = new Date(this.dataset.end).getTime();
        this.tick();
        this.interval = window.setInterval(() => this.tick(), 1000);
      }
      disconnectedCallback() { window.clearInterval(this.interval); }
      tick() {
        let remaining = Math.max(0, Math.floor((this.endTime - Date.now()) / 1000));
        const days = Math.floor(remaining / 86400); remaining %= 86400;
        const hours = Math.floor(remaining / 3600); remaining %= 3600;
        const minutes = Math.floor(remaining / 60); const seconds = remaining % 60;
        this.querySelector('[data-days]').textContent = String(days).padStart(2, '0');
        this.querySelector('[data-hours]').textContent = String(hours).padStart(2, '0');
        this.querySelector('[data-minutes]').textContent = String(minutes).padStart(2, '0');
        this.querySelector('[data-seconds]').textContent = String(seconds).padStart(2, '0');
        if (this.endTime <= Date.now()) window.clearInterval(this.interval);
      }
    }
    customElements.define(tag, CountdownTimer);
  })();
</script>
{% schema %}
{
  "name": "Countdown timer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sale ends in" },
    { "type": "text", "id": "end_datetime", "label": "End date and time", "default": "2026-12-31T23:59:59" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "vertical_padding", "label": "Vertical padding", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 6 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F3F3F3" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" }
  ],
  "presets": [{ "name": "Countdown timer" }],
  "tag": null,
  "class": "countdown-timer-block"
}
{% endschema %}