{% doc %}
  @prompt
    countdown
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 24px;
    text-align: center;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  }

  .ai-countdown-{{ ai_gen_id }}__heading {
    margin: 0 0 8px;
    color: inherit;
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-size: 28px;
    line-height: 1.2;
  }

  .ai-countdown-{{ ai_gen_id }}__message {
    margin: 0 0 18px;
    font-size: 16px;
  }

  .ai-countdown-{{ ai_gen_id }}__timer {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-countdown-{{ ai_gen_id }}__unit {
    min-width: 68px;
    padding: 12px 10px;
    border: 1px solid currentColor;
  }

  .ai-countdown-{{ ai_gen_id }}__number {
    display: block;
    font-size: 26px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    line-height: 1.1;
  }

  .ai-countdown-{{ ai_gen_id }}__label {
    display: block;
    margin-top: 5px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .ai-countdown-{{ ai_gen_id }}__ended {
    margin: 0;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-countdown-{{ ai_gen_id }} { padding: 20px 14px; }
    .ai-countdown-{{ ai_gen_id }}__unit { min-width: 58px; padding: 10px 8px; }
    .ai-countdown-{{ ai_gen_id }}__number { font-size: 22px; }
  }
{% endstyle %}

<ai-countdown-{{ ai_gen_id }} class="ai-countdown-{{ ai_gen_id }}" data-end="{{ block.settings.end_date | escape }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-countdown-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.message != blank %}<p class="ai-countdown-{{ ai_gen_id }}__message">{{ block.settings.message | escape }}</p>{% endif %}
  <div class="ai-countdown-{{ ai_gen_id }}__timer" role="timer" aria-live="off">
    <div class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__number" data-days>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">Days</span></div>
    <div class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__number" data-hours>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">Hours</span></div>
    <div class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__number" data-minutes>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">Minutes</span></div>
    <div class="ai-countdown-{{ ai_gen_id }}__unit"><span class="ai-countdown-{{ ai_gen_id }}__number" data-seconds>00</span><span class="ai-countdown-{{ ai_gen_id }}__label">Seconds</span></div>
  </div>
  <p class="ai-countdown-{{ ai_gen_id }}__ended" data-ended hidden>{{ block.settings.ended_message | escape }}</p>
</ai-countdown-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'ai-countdown-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class AiCountdown extends HTMLElement {
      connectedCallback() {
        this.endTime = new Date(this.dataset.end).getTime();
        this.timer = this.querySelector('.ai-countdown-{{ ai_gen_id }}__timer');
        this.ended = this.querySelector('[data-ended]');
        this.tick();
        this.interval = window.setInterval(() => this.tick(), 1000);
      }
      disconnectedCallback() {
        window.clearInterval(this.interval);
      }
      tick() {
        if (!Number.isFinite(this.endTime) || Date.now() >= this.endTime) {
          this.timer.hidden = true;
          this.ended.hidden = false;
          window.clearInterval(this.interval);
          return;
        }
        let remaining = Math.floor((this.endTime - Date.now()) / 1000);
        const days = Math.floor(remaining / 86400);
        remaining %= 86400;
        const hours = Math.floor(remaining / 3600);
        remaining %= 3600;
        const minutes = Math.floor(remaining / 60);
        const seconds = remaining % 60;
        this.querySelector('[data-days]').textContent = String(days).padStart(2, '0');
        this.querySelector('[data-hours]').textContent = String(hours).padStart(2, '0');
        this.querySelector('[data-minutes]').textContent = String(minutes).padStart(2, '0');
        this.querySelector('[data-seconds]').textContent = String(seconds).padStart(2, '0');
      }
    }
    customElements.define(tagName, AiCountdown);
  })();
</script>

{% schema %}
{
  "name": "Countdown timer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A little something is coming" },
    { "type": "text", "id": "message", "label": "Message", "default": "Mark the date and get ready to shop." },
    { "type": "text", "id": "end_date", "label": "End date and time", "default": "2026-12-31T23:59:59+00:00", "info": "Use ISO format with timezone, for example 2026-12-31T23:59:59+00:00." },
    { "type": "text", "id": "ended_message", "label": "After countdown", "default": "The countdown has ended." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F3F3F3" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" }
  ],
  "presets": [{ "name": "Countdown timer" }],
  "tag": null,
  "class": "countdown-timer-block"
}
{% endschema %}