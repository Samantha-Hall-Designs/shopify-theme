        "heading_TrHhCA": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Responsibly sourced materials</strong>",
            "heading_size": "h1"
          }
        },
        "text_xiYpnA": {
          "type": "text",
          "settings": {
            "text": "<p>Our sustainable journey begins with carefully selected partners who share our environmental values:</p><ul><li><strong>FSC-certified paper</strong>: All our notebooks and cards use paper from responsibly managed forests</li><li><strong>Eco-friendly dyes</strong>: Our fabric products feature water-based dyes that minimise environmental impact</li><li><strong>Local partnerships</strong>: We work with a Brighton seamstress for our scrunchies and cushions, supporting our community while reducing transportation emissions</li><li><strong>European suppliers</strong>: Our materials come from sources meeting strict environmental standards</li></ul><p>We believe transparency matters. Our primary manufacturer's carbon reporting demonstrates their commitment to continuous improvement in reducing environmental impact.</p>"
          }
        },
