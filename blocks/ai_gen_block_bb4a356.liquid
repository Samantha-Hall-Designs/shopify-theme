{% doc %}
  @prompt
    image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
  }

  .ai-image-block-{{ ai_gen_id }}__frame {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .ai-image-block-{{ ai_gen_id }}__image {
    display: block;
    width: 100%;
    height: auto;
    {% if block.settings.image_ratio == 'square' %}
      aspect-ratio: 1 / 1;
      object-fit: cover;
    {% elsif block.settings.image_ratio == 'portrait' %}
      aspect-ratio: 4 / 5;
      object-fit: cover;
    {% elsif block.settings.image_ratio == 'landscape' %}
      aspect-ratio: 3 / 2;
      object-fit: cover;
    {% endif %}
  }

  .ai-image-block-{{ ai_gen_id }}__placeholder {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 220px;
    aspect-ratio: 3 / 2;
    background: #f3f3f3;
    color: #333333;
  }

  .ai-image-block-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    max-height: 520px;
  }

  .ai-image-block-{{ ai_gen_id }}__empty-state {
    position: absolute;
    inset-inline: 16px;
    bottom: 16px;
    margin: 0;
    padding: 10px 14px;
    background: #ffffff;
    color: #333333;
    font-size: 14px;
    text-align: center;
  }

  .ai-image-block-{{ ai_gen_id }}__caption {
    margin: 10px 0 0;
    color: #121212;
    font-size: 15px;
    line-height: 1.45;
    text-align: {{ block.settings.caption_alignment }};
  }

  .ai-image-block-{{ ai_gen_id }}__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ai-image-block-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
{% endstyle %}

<div class="ai-image-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.image_link != blank %}
    <a class="ai-image-block-{{ ai_gen_id }}__link" href="{{ block.settings.image_link }}" aria-label="{{ block.settings.image_alt | default: 'Open linked image' | escape }}">
  {% endif %}
  <div class="ai-image-block-{{ ai_gen_id }}__frame">
    {% if block.settings.image != blank %}
      <img
        class="ai-image-block-{{ ai_gen_id }}__image"
        src="{{ block.settings.image | image_url: width: 2000 }}"
        alt="{{ block.settings.image_alt | default: block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
      >
    {% else %}
      <div class="ai-image-block-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
        <p class="ai-image-block-{{ ai_gen_id }}__empty-state">Add an image in the block settings to get started.</p>
      </div>
    {% endif %}
  </div>
  {% if block.settings.image_link != blank %}
    </a>
  {% endif %}
  {% if block.settings.caption != blank %}
    <p class="ai-image-block-{{ ai_gen_id }}__caption">{{ block.settings.caption | escape }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt text",
      "info": "Describe the image for accessibility."
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image link"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "natural", "label": "Natural" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "natural"
    },
    {
      "type": "select",
      "id": "caption_alignment",
      "label": "Caption alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Image"
    }
  ],
  "tag": null,
  "class": "image-block"
}
{% endschema %}